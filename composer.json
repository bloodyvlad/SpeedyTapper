{
  "name": "otcsoft/speedytapper",
  "description": "SpeedyTapper PHP API for Hostinger.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "firebase/php-jwt": "^7.1",
    "google/apiclient": "^2.18"
  },
  "autoload": {
    "psr-4": {
      "SpeedyTapper\\": "server/src/"
    }
  },
  "scripts": {
    "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
    "dev": "php -S 0.0.0.0:4173 -t . server/dev-router.php",
    "lint": "php server/bin/check.php lint",
    "test": "php server/bin/check.php test",
    "check": [
      "@composer validate --strict --no-check-publish",
      "@composer audit --locked --no-dev",
      "@lint",
      "@test"
    ],
    "test:mariadb:game-center": "test/game-center-autolink-mariadb.sh",
    "test:mariadb:nickname": "test/nickname-migration-mariadb.sh",
    "test:mariadb:internal-alpha-reset": "test/internal-alpha-reset-mariadb.sh",
    "test:mariadb:multiplayer-v2": "bash test/multiplayer-v2-mariadb.sh"
  },
  "extra": {
    "google/apiclient-services": [
      "Oauth2"
    ]
  },
  "config": {
    "allow-plugins": false,
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
